<?xml version="1.0"?>
<robot name="mecanum_lidar_robot"
       xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema">

  <xacro:arg name="robot_name" default="maze_robot"/>
  <xacro:arg name="prefix" default="maze_robot/robot"/>
  <xacro:arg name="scan_topic" default="/maze_robot/scan"/>

  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="prefix" value="$(arg prefix)"/>
  <xacro:property name="scan_topic" value="$(arg scan_topic)"/>
  <xacro:property name="chassis_mass" value="1.3"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="wheel_radius" value="0.023"/>

  <material name="blue">
    <color rgba="0.25 0.55 0.95 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  <material name="while">
    <color rgba="1 1 1 1"/>
  </material>

  <link name="${prefix}base_footprint"/>

  <joint name="${prefix}base_joint" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.1 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    
  </link>
 
<joint name="${prefix}lidar_joint" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <origin xyz="0.05 0 0.035" rpy="0 0 0"/>
  </joint>

  <link name="${prefix}lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.0278" length="0.0413"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.0278" length="0.0413"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <xacro:macro name="mecanum_wheel" params="wheel_prefix x y friction_dir mesh_type">
    <joint name="${prefix}${wheel_prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}${wheel_prefix}_wheel"/>
      <origin xyz="${x} ${y} -0.023" rpy="-1.57079632679 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <link name="${prefix}${wheel_prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <mesh filename="https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mecanum%20lift/tip/files/meshes/mecanum_wheel_${mesh_type}.STL"
                scale="0.00046 0.00046 0.00046"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision name="${prefix}${wheel_prefix}_wheel_collision">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${wheel_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000008" ixy="0" ixz="0" iyy="0.000008" iyz="0" izz="0.000013"/>
      </inertial>
    </link>

    <gazebo reference="${prefix}${wheel_prefix}_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>3.0</mu>
              <mu2>0.05</mu2>
              <fdir1 gz:expressed_in="${prefix}base_footprint">${friction_dir}</fdir1>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>10000000.0</kp>
              <kd>1.0</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel wheel_prefix="front_left"  x="0.0645"  y="0.0575"  friction_dir="1 -1 0" mesh_type="left"/>
  <xacro:mecanum_wheel wheel_prefix="front_right" x="0.0645"  y="-0.0575" friction_dir="1 1 0"  mesh_type="right"/>
  <xacro:mecanum_wheel wheel_prefix="rear_left"   x="-0.0645" y="0.0575"  friction_dir="1 1 0"  mesh_type="right"/>
  <xacro:mecanum_wheel wheel_prefix="rear_right"  x="-0.0645" y="-0.0575" friction_dir="1 -1 0" mesh_type="left"/>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>${prefix}front_left_wheel_joint</front_left_joint>
      <front_right_joint>${prefix}front_right_wheel_joint</front_right_joint>
      <back_left_joint>${prefix}rear_left_wheel_joint</back_left_joint>
      <back_right_joint>${prefix}rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.115</wheel_separation>
      <wheelbase>0.129</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_acceleration>-5</min_acceleration>
      <max_acceleration>5</max_acceleration>
      <topic>/model/${robot_name}/cmd_vel</topic>
      <odom_topic>/model/${robot_name}/odometry</odom_topic>
      <tf_topic>/model/${robot_name}/tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}lidar_link">
    <sensor name="${robot_name}_lidar" type="gpu_lidar">
      <topic>${scan_topic}</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <gz_frame_id>${prefix}lidar_link</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
    </sensor>
  </gazebo>

</robot>
